# MediIndex mobile — local development configuration
#
# Copy to `.env` (git-ignored) and set the backend origin this device can reach.
# Only EXPO_PUBLIC_* variables are exposed to the app bundle.
# NEVER put a secret here: everything in the bundle is readable in the shipped app.

# Android emulator (AVD) reaching a server on the host machine:
EXPO_PUBLIC_MOBILE_API_BASE_URL=http://10.0.2.2:3000

# Physical device on the same Wi-Fi — use your machine's LAN IP instead:
# EXPO_PUBLIC_MOBILE_API_BASE_URL=http://192.168.1.10:3000

# NOTE: the MediIndex Vercel Preview is behind Deployment Protection (SSO), which
# a mobile device cannot authenticate through. Point this at a local server or an
# unprotected deployment. Do not attempt to bypass SSO.
