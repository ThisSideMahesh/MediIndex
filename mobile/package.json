{
  "name": "mediindex-mobile",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-community/netinfo": "^12.0.1",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.2",
    "expo": "~57.0.24",
    "expo-camera": "~57.0.5",
    "expo-secure-store": "~57.0.4",
    "expo-sqlite": "^57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --test $(ls tests/*.test.js | grep -v -E 'real-sqlite-integration|real-sync-integration|real-sync-critical-e2e|real-error-handling')",
    "test:sqlite-integration": "node --experimental-strip-types --import ./tests/helpers/registerTsResolver.mjs --test tests/real-sqlite-integration.test.js tests/real-sync-integration.test.js tests/real-error-handling.test.js tests/real-sync-critical-e2e.test.js",
    "verify": "npm run typecheck && npm test && npm run test:sqlite-integration"
  },
  "private": true,
  "description": "MediIndex mobile stock-entry app (React Native + Expo)"
}
