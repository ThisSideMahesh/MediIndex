# MediIndex mobile — PRODUCTION configuration
# This file configures the Android release APK to communicate with the production Vercel deployment.
#
# IMPORTANT:
# - This file is used ONLY for production builds
# - NO secrets, passwords, tokens, or API keys belong here
# - Everything in this file is embedded in the APK and readable by anyone
# - Device pairing tokens are obtained at runtime via the pairing flow

# Production backend (Vercel + Neon PostgreSQL)
EXPO_PUBLIC_MOBILE_API_BASE_URL=https://mediindex.vercel.app
