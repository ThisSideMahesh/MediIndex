# MediIndex Environment Configuration

# ============================================================
# LOCAL DEVELOPMENT (SQLite)
# ============================================================
# Leave DATABASE_URL unset to use local SQLite database
# DATA_DIR=./data
# PORT=3000

# ============================================================
# CLOUD DEPLOYMENT (PostgreSQL)
# ============================================================
# Set DATABASE_URL to use PostgreSQL (Vercel, Neon, Supabase, etc.)
# DATABASE_URL=postgresql://username:password@host:5432/database
# DATABASE_URL=postgres://user:pass@aws-0-region.compute.amazonaws.com:5432/dbname

# ============================================================
# POSTGRESQL INTEGRATION TESTING (Optional)
# ============================================================
# Set POSTGRES_TEST_URL to run PostgreSQL integration tests
# Use a dedicated test database, NOT production data
# POSTGRES_TEST_URL=postgresql://testuser:testpass@localhost:5432/mediindex_test

# ============================================================
# SECURITY NOTES
# ============================================================
# - NEVER commit this file with real credentials
# - Use environment variables in production (Vercel dashboard)
# - DATABASE_URL is automatically detected by the adapter factory
# - If DATABASE_URL is set → PostgreSQLAdapter
# - If DATABASE_URL is unset → SQLiteAdapter (local data/mediindex.db)
